<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================================
         TEST FIXTURE ONLY. Nothing in this file ships: it lives under src/test and is
         reached only through db.changelog-test-master.xml.

         PRG READS nine relations it does not own and, from this change on, does not
         create. Its own integration tests still need them to exist, because PRG's
         views resolve their targets at CREATE time. In production the owning services
         create them; here this fixture stands in for those services, and it must run
         BEFORE the production master for the same reason.

         Owners, all single-writer per R-04:
           tx_header, tx_entry .......................... PRR
           validation_log ............................... PTV
           isr_resp / sbsr_resp / pbsr_resp ............. PIX / PSX / PPX
           prw_emission_group / prw_emission /
           prw_emission_member .......................... PRW

         WHY IT MOVED HERE (2026-08-08, family consistency with CRG, which retired the
         identical anti-pattern first). The bodies below used to ship, guarded with
         onFail="CONTINUE", so PRG could migrate before its peers on a fresh database.
         Two things were wrong with that, and neither is fixed by tightening the guard:

           - it made PRG a SECOND writer of nine relations it does not own. The guard
             skips silently, so whichever service migrated second inherited the other's
             shape permanently and invisibly, and the mint had already drifted from its
             owner once in the collections twin.
           - a CRG mint winning that race would crashloop the OWNER, which is a worse
             failure than the one the guard prevents.

         What replaces it is stated as an ordering contract in the production master and
         in 003-pay-status-views.xml: PRG's migration must run after the writers'. If it
         does not, the view changelog FAILS and names the missing relation. That failure
         is loud, it is retried by the pod's restart, and it converges the moment the
         owner migrates. It is emphatically NOT the silent-zero shape (A-76, A-79): a
         missing relation cannot yield an empty result here, because CockroachDB resolves
         a view body at CREATE time and refuses to create it at all.

         The owners' own re-run preconditions were stripped, because this fixture runs
         once against an empty test database.

         THIS IS A HAND-MAINTAINED MIRROR OF OTHER REPOSITORIES' DDL, which is a drift
         class: PRG's suite can stay green against a shape the owner has already changed.
         BootstrapSourceParityTest is what makes that a checked fact rather than a
         comment, and it is the half of this pattern CRG's equivalent fixture still lacks.
         ============================================================================ -->

    <!-- ============================ PRR: the payments spine ==================== -->

    <changeSet id="prg-testfixture-tx-header" author="dcre">
        <createTable tableName="tx_header">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_pay_header_arrival"/>
            </column>
            <column name="msg_id_raw" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="created_ts" type="VARCHAR(14)"><constraints nullable="false"/></column>
            <column name="tx_count" type="INT"><constraints nullable="false"/></column>
            <column name="initg_pty" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="business_date" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="client_token" type="VARCHAR(16)"/>
            <column name="layout_version" type="INT"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback><dropTable tableName="tx_header"/></rollback>
    </changeSet>

    <changeSet id="prg-testfixture-tx-entry" author="dcre">
        <createTable tableName="tx_entry">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="sequence" type="INT"><constraints nullable="false"/></column>
            <column name="record_type" type="VARCHAR(2)"><constraints nullable="false"/></column>
            <column name="e2e_raw" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="creditor_account" type="VARCHAR(23)"><constraints nullable="false"/></column>
            <column name="contract_ref" type="VARCHAR(14)"/>
            <column name="currency" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="amount_raw" type="VARCHAR(15)"><constraints nullable="false"/></column>
            <column name="amount" type="DECIMAL(18,2)"><constraints nullable="false"/></column>
            <column name="branch_code" type="VARCHAR(11)"/>
            <column name="debtor_name" type="VARCHAR(35)"/>
            <column name="debtor_account" type="VARCHAR(23)"/>
            <column name="acc_type_seq" type="VARCHAR(8)"/>
            <!-- Present in the SHARED physical layout, expected NULL on every ENDO
                 row: the mandate gate is DC-only (R-19). PRG never reads it, which
                 is why there is no payments successor to CRG's
                 man_collection_outcome view. -->
            <column name="mandate_ref" type="VARCHAR(35)"/>
            <column name="content_hash" type="CHAR(64)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="tx_entry" columnNames="arrival_id, sequence"
                             constraintName="uq_pay_entry_arrival_sequence"/>
        <createIndex tableName="tx_entry" indexName="idx_pay_entry_arrival_content_hash">
            <column name="arrival_id"/>
            <column name="content_hash"/>
            <column name="sequence"/>
        </createIndex>
        <rollback><dropTable tableName="tx_entry"/></rollback>
    </changeSet>

    <!-- ============================ PTV: the verdict store ===================== -->

    <changeSet id="prg-testfixture-validation-log" author="dcre">
        <createTable tableName="validation_log">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="sequence" type="INT"><constraints nullable="false"/></column>
            <column name="outcome" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="detail" type="VARCHAR(256)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="validation_log" columnNames="arrival_id, sequence"
                             constraintName="uq_validation_arrival_sequence"/>
        <rollback><dropTable tableName="validation_log"/></rollback>
    </changeSet>

    <!-- ================== PIX / PSX / PPX: the response cylinders ============== -->
    <!-- Unprefixed, exactly as the payments RESP sheet labels them, and carrying NO
         emission_id column: PIX/PSX/PPX dropped CIX's emission FK deliberately, so
         PRG correlates a reply to its outbound batch through
         orgnl_msg_id = prw_emission.outbound_msg_id instead (see 003). -->

    <changeSet id="prg-testfixture-isr-resp" author="dcre">
        <createTable tableName="isr_resp">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="response_file" type="VARCHAR(512)"><constraints nullable="false"/></column>
            <column name="orgnl_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(8)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="isr_resp" columnNames="response_file, e2e"
                             constraintName="uq_pay_isr_resp_file_e2e"/>
        <rollback><dropTable tableName="isr_resp"/></rollback>
    </changeSet>

    <changeSet id="prg-testfixture-sbsr-resp" author="dcre">
        <createTable tableName="sbsr_resp">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="response_file" type="VARCHAR(512)"><constraints nullable="false"/></column>
            <column name="orgnl_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(8)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="sbsr_resp" columnNames="response_file, e2e"
                             constraintName="uq_pay_sbsr_resp_file_e2e"/>
        <rollback><dropTable tableName="sbsr_resp"/></rollback>
    </changeSet>

    <changeSet id="prg-testfixture-pbsr-resp" author="dcre">
        <createTable tableName="pbsr_resp">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="response_file" type="VARCHAR(512)"><constraints nullable="false"/></column>
            <column name="orgnl_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(8)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="pbsr_resp" columnNames="response_file, e2e"
                             constraintName="uq_pay_pbsr_resp_file_e2e"/>
        <rollback><dropTable tableName="pbsr_resp"/></rollback>
    </changeSet>

    <!-- ===================== PRW: the payments emission registry =============== -->
    <!-- No run_date anywhere: payments does not warehouse (PRW 001 states the
         reasoning in full). Every CRW identity tuple loses that dimension here. -->

    <changeSet id="prg-testfixture-emission-group" author="dcre">
        <createTable tableName="prw_emission_group">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <!-- VARCHAR(16), matching PRW's owning declaration after A-43 (ruled 2026-08-08)
                 made tx_header.client_token the authority this column carries. 35 was
                 initg_pty's width and is no longer any source's. BootstrapSourceParityTest
                 is what makes this a checked fact rather than a remembered one. -->
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="source_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="applied_max" type="INT"><constraints nullable="false"/></column>
            <column name="total_tx" type="BIGINT"><constraints nullable="false"/></column>
            <column name="total_amount" type="DECIMAL(18,2)"><constraints nullable="false"/></column>
            <column name="expected_batch_count" type="INT"><constraints nullable="false"/></column>
            <column name="split" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="prw_emission_group" columnNames="arrival_id"
                             constraintName="uq_prw_group_arrival"/>
        <addUniqueConstraint tableName="prw_emission_group" columnNames="client, source_msg_id"
                             constraintName="uq_prw_group_client_msg"/>
        <rollback><dropTable tableName="prw_emission_group"/></rollback>
    </changeSet>

    <changeSet id="prg-testfixture-emission" author="dcre">
        <createTable tableName="prw_emission">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="group_id" type="UUID"><constraints nullable="false"/></column>
            <column name="arrival_id" type="UUID"><constraints nullable="false"/></column>
            <column name="batch_ordinal" type="INT"><constraints nullable="false"/></column>
            <column name="outbound_msg_id" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="file_name" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="state" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="tx_count" type="BIGINT"/>
            <column name="control_sum" type="DECIMAL(18,2)"/>
            <column name="visible_at" type="TIMESTAMPTZ"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="prw_emission" columnNames="arrival_id, batch_ordinal"
                             constraintName="uq_prw_emission_arrival_ordinal"/>
        <!-- The globally unique outbound identity. It is also the ONLY correlation
             path PRG has from a reply back to its batch, so it is load-bearing here
             in a way it is not in PRW. -->
        <createIndex tableName="prw_emission" indexName="uq_prw_emission_outbound_msg" unique="true">
            <column name="outbound_msg_id"/>
        </createIndex>
        <rollback><dropTable tableName="prw_emission"/></rollback>
    </changeSet>

    <changeSet id="prg-testfixture-emission-member" author="dcre">
        <createTable tableName="prw_emission_member">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="emission_id" type="UUID"><constraints nullable="false"/></column>
            <column name="sequence" type="INT"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="amount" type="DECIMAL(18,2)"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="prw_emission_member" columnNames="emission_id, sequence"
                             constraintName="uq_prw_member_emission_sequence"/>
        <rollback><dropTable tableName="prw_emission_member"/></rollback>
    </changeSet>

    <!-- ==================== PRG-owned read-path indexes ======================== -->
</databaseChangeLog>
