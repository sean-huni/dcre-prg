    <!-- ============================ delta watermark ============================ -->
    <!-- Per-client delta watermark: the last externally reported status per e2e.
         client is VARCHAR(16), matching CRG, tx_header.client_token and (since A-43)
         prw_emission_group.client.

         An earlier draft widened it to 35 on the reasoning that prw_emission_group.client was 35
         and PRG reads client out of that table through prg_report_due. That reasoning was a
         correct description of a DIFFERENT problem and the wrong response to it: `client` had two
         homes in dcre_pay, tx_header.client_token (what ext_tx_status and every PRG write path
         carry) and prw_emission_group.client, which PRW wrote from tx_header.initg_pty. They were
         equal only when an R-31 filename token was present, so a NULL or differing client_token
         made prg_report_due name a parent whose rows the watermark reads could not then select:
         the IMMEDIATE report emits nothing, nothing is ledgered, the parent stays due and AGT
         retriggers it forever with no error anywhere. Widening the column would not have fixed
         that; it would have removed the one configuration in which the mismatch could fail loudly.

         RESOLVED at the source, 2026-08-08 (A-43): the owner ruled tx_header.client_token the
         authority, PRW now writes prw_emission_group.client from it (COALESCE with initg_pty for
         an arrival that carried no filename token) and narrowed that column to 16 to match. The
         two homes are now one authority with a documented fallback. The narrow column here was
         right for the wrong reason and is now right for the right one. PRG's ClientAuthorityIT is
         the fixture that can tell the difference; every other fixture in this module seeds both
         columns to one value and cannot. -->
    <changeSet id="prg-002-watermark" author="dcre">
        <!-- A-82: this changeset gained a re-run guard AFTER it had already been applied,
             which changes the enclosing checksum without changing one byte of the DDL
             below. ANY rather than a pinned value: kind-dcre-dev stored 9:ec77b31ac24ad36f2a0f0d9e63f38474,
             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="prg_watermark"/></not>
        </preConditions>
        
        <createTable tableName="prg_watermark">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="last_status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <!-- BaseEntity (configuration.md point 20). -->
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback><dropTable tableName="prg_watermark"/></rollback>
    </changeSet>

    <!-- The FULL business identity of a watermark row. CockroachDB resolves UPSERT
         on the PRIMARY KEY only, so the writer's
         INSERT ... ON CONFLICT (client, e2e) DO UPDATE needs this constraint to
         exist, or a restarted advance duplicates instead of rewriting. -->
    <changeSet id="prg-002-watermark-identity" author="dcre">
        <!-- A-82: this changeset gained a re-run guard AFTER it had already been applied,
             which changes the enclosing checksum without changing one byte of the DDL
             below. ANY rather than a pinned value: kind-dcre-dev stored 9:bda4f0d8bf50fb2f443b03eb6d185c00,
             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="prg_watermark" indexName="uq_prg_watermark_client_e2e"/></not>
        </preConditions>
        
        <addUniqueConstraint tableName="prg_watermark" columnNames="client, e2e"
                             constraintName="uq_prg_watermark_client_e2e"/>
        <rollback>
            <dropUniqueConstraint tableName="prg_watermark"
                                  constraintName="uq_prg_watermark_client_e2e"/>
        </rollback>
    </changeSet>

    <!-- ============================ report registry ============================ -->
    <!-- One row per emitted report artifact. Append-only: no version/updated_at, so
         the entity rides Persistable rather than the @Version new-ness heuristic.

         COLUMN NAME: `type`, not CRG's `report_type`. A column never repeats its own
         table name (estate rule; the canonical example is report.ref rather than
         report.report_ref), and prg_report.report_type is exactly that shape. This
         is the one deliberate column-level divergence from CRG in this file, taken
         because a v1 baseline on an empty database is the only moment it is free.
         `trigger_kind`, `window_key`, `file_name` and `job_name` do NOT repeat the
         table name and keep CRG's spelling. -->
    <changeSet id="prg-002-report" author="dcre">
        <!-- A-82: this changeset gained a re-run guard AFTER it had already been applied,
             which changes the enclosing checksum without changing one byte of the DDL
             below. ANY rather than a pinned value: kind-dcre-dev stored 9:49301f014a51a68940d5ce2e15328a0e,
             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="prg_report"/></not>
        </preConditions>
        
        <createTable tableName="prg_report">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="type" type="VARCHAR(12)"><constraints nullable="false"/></column>
            <column name="trigger_kind" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="window_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="parent_source_msg_id" type="VARCHAR(35)"/>
            <!-- Unique: the restart no-op lookup. A standing row means the emission
                 already registered, so a replayed window reuses it (R-24). -->
            <column name="file_name" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_prg_report_file"/>
            </column>
            <!-- SCRUM-58 clock-scoped trace-join anchor: a clock-launched PSR has no
                 single arrival, so rpt joins its launching job's ops steps through
                 agt_ops.launch_intent.job_name. VARCHAR(63) matches that contract.
                 Declared here, not added by a later ALTER as in CRG. -->
            <column name="job_name" type="VARCHAR(63)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="prg_report" indexName="ix_prg_report_job">
            <column name="job_name"/>
        </createIndex>
        <rollback><dropTable tableName="prg_report"/></rollback>
    </changeSet>

