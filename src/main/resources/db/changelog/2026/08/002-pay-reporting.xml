    <changeSet id="prg-002-ledger-auto-guard" author="dcre">
        <!-- A-82: this changeset gained a re-run guard AFTER it had already been applied,
             which changes the enclosing checksum without changing one byte of the DDL
             below. ANY rather than a pinned value: kind-dcre-dev stored 9:5d312bdd367fd3ff9a9352f43c453ed8,
             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="prg_delivery_ledger" indexName="uq_prg_ledger_auto"/></not>
        </preConditions>
        
        <!-- LIQUIBASE-SQL-EXCEPTION: a PARTIAL unique index (WHERE clause) has no
             typed Liquibase tag. The predicate is the whole point: the auto-send
             guard must arbitrate (client, e2e, status) in the DATABASE so the same
             tuple is never auto-sent twice across restarts or racing writers, while
             manual_ref rows fall OUTSIDE the index so a manual override bypasses the
             guard and still writes its audit row. -->
        <sql>CREATE UNIQUE INDEX uq_prg_ledger_auto ON prg_delivery_ledger (client, e2e, status) WHERE manual_ref IS NULL;</sql>
        <rollback>
            <dropIndex tableName="prg_delivery_ledger" indexName="uq_prg_ledger_auto"/>
        </rollback>
    </changeSet>

    <!-- SCRUM-55 perf lesson, carried because the cause is structural rather than
         historical: without these the pick views degrade to nested-loop lookups per
         transaction row, which hung the live AGT trigger scan for 7+ minutes on a
         12,001-tx parent. They sit on tables PRG does not own, which is why they
         carry the prg_ prefix and are declared here rather than in PIX/PSX/PPX. This is the
         shape CRG uses (002-reporting-tables.xml): PRG DECLARES indexes it needs on
         relations it reads, and creates no relation it does not own. The index changesets
         carry no presence guard, for the same reason the views do not: they run after the
         owners' migrations, and a missing table fails loudly and names itself. -->

