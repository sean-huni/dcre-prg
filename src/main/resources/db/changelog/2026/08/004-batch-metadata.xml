<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================================
         PRG v1 BASELINE: Spring Batch 6.0.4 job-repository metadata, typed tags.

         THIS IS THE VERSION 1 BASELINE. Every DCRE database is dropped and recreated
         at the v1 cutover, so this changelog only ever runs against an EMPTY schema.
         That is why the usual re-run guards are absent, and their absence is
         deliberate rather than an oversight:

           - no ANY-checksum override. It existed because the SQL file behind this
             changeset was edited after it had executed on live databases, so its
             checksum no longer matched the recorded one (A-81). With no recorded
             history there is no checksum to contradict, and suppressing checksum
             validation on a baseline would only disarm the control for every FUTURE
             edit.
           - no IF-NOT-EXISTS clauses, and no onFail="MARK_RAN" preconditions. Both
             guarded against objects created by an earlier, different changelog. On an
             empty schema every CREATE here is the first and only one, so a guard
             could not fire, and a guard that cannot fire is dead weight that would
             silently skip real work if the assumption ever changed.

         Pure typed tags, no raw-SQL body and no external SQL file (2026-08-08, family
         consistency with CRG, which made this conversion first and which PRG was forked
         from before it). The previous form here was an external batch-metadata-prg.sql
         with IF NOT EXISTS on every CREATE and a validCheckSum ANY override. Both were
         inherited reasoning rather than live requirements: the SQL file hid its DDL from
         static analysis (the cleanout audit's first extractor could not see relations
         created inside raw SQL) and pinned the file to one dialect; IF NOT EXISTS
         answered a half-applied multi-statement file, which typed changesets do not
         produce because each object is its own changeset with its own history row; and
         validCheckSum ANY on a baseline that has never executed anywhere suppresses
         validation for every FUTURE edit while protecting nothing.

         The table prefix PRG_BATCH_ isolates this service's job metadata on the
         shared dcre_pay database; dcre.batch.table-prefix in application.yml must
         agree with it. Two deliberate departures from Spring Batch's shipped DDL are
         preserved: EXIT_MESSAGE is TEXT rather than VARCHAR(2500) for CockroachDB,
         and constraint names are scoped per table, which CockroachDB permits and
         which lets all nine payments services coexist in one schema.
         ============================================================================ -->

    <changeSet id="prg-v1-batch-job-instance" author="dcre">
        <createTable tableName="PRG_BATCH_JOB_INSTANCE">
            <column name="JOB_INSTANCE_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT"/>
            <column name="JOB_NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="JOB_KEY" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="PRG_BATCH_JOB_INSTANCE"
                             columnNames="JOB_NAME, JOB_KEY" constraintName="JOB_INST_UN"/>
        <rollback>
            <dropTable tableName="PRG_BATCH_JOB_INSTANCE"/>
        </rollback>
    </changeSet>

    <changeSet id="prg-v1-batch-job-execution" author="dcre">
        <createTable tableName="PRG_BATCH_JOB_EXECUTION">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT"/>
            <column name="JOB_INSTANCE_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="START_TIME" type="TIMESTAMP"/>
            <column name="END_TIME" type="TIMESTAMP"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="EXIT_CODE" type="VARCHAR(2500)"/>
            <column name="EXIT_MESSAGE" type="TEXT"/>
            <column name="LAST_UPDATED" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_INST_EXEC_FK"
                                 baseTableName="PRG_BATCH_JOB_EXECUTION" baseColumnNames="JOB_INSTANCE_ID"
                                 referencedTableName="PRG_BATCH_JOB_INSTANCE" referencedColumnNames="JOB_INSTANCE_ID"/>
        <rollback>
            <dropTable tableName="PRG_BATCH_JOB_EXECUTION"/>
        </rollback>
    </changeSet>

    <changeSet id="prg-v1-batch-job-execution-params" author="dcre">
        <createTable tableName="PRG_BATCH_JOB_EXECUTION_PARAMS">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="PARAMETER_NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="PARAMETER_TYPE" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="PARAMETER_VALUE" type="VARCHAR(2500)"/>
            <column name="IDENTIFYING" type="CHAR(1)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_EXEC_PARAMS_FK"
                                 baseTableName="PRG_BATCH_JOB_EXECUTION_PARAMS" baseColumnNames="JOB_EXECUTION_ID"
                                 referencedTableName="PRG_BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
        <rollback>
            <dropTable tableName="PRG_BATCH_JOB_EXECUTION_PARAMS"/>
        </rollback>
    </changeSet>

    <changeSet id="prg-v1-batch-step-execution" author="dcre">
        <createTable tableName="PRG_BATCH_STEP_EXECUTION">
            <column name="STEP_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="STEP_NAME" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATE_TIME" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="START_TIME" type="TIMESTAMP"/>
            <column name="END_TIME" type="TIMESTAMP"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="COMMIT_COUNT" type="BIGINT"/>
            <column name="READ_COUNT" type="BIGINT"/>
            <column name="FILTER_COUNT" type="BIGINT"/>
            <column name="WRITE_COUNT" type="BIGINT"/>
            <column name="READ_SKIP_COUNT" type="BIGINT"/>
            <column name="WRITE_SKIP_COUNT" type="BIGINT"/>
            <column name="PROCESS_SKIP_COUNT" type="BIGINT"/>
            <column name="ROLLBACK_COUNT" type="BIGINT"/>
            <column name="EXIT_CODE" type="VARCHAR(2500)"/>
            <column name="EXIT_MESSAGE" type="TEXT"/>
            <column name="LAST_UPDATED" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_EXEC_STEP_FK"
                                 baseTableName="PRG_BATCH_STEP_EXECUTION" baseColumnNames="JOB_EXECUTION_ID"
                                 referencedTableName="PRG_BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
        <rollback>
            <dropTable tableName="PRG_BATCH_STEP_EXECUTION"/>
        </rollback>
    </changeSet>

    <changeSet id="prg-v1-batch-step-execution-context" author="dcre">
        <createTable tableName="PRG_BATCH_STEP_EXECUTION_CONTEXT">
            <column name="STEP_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SHORT_CONTEXT" type="VARCHAR(2500)">
                <constraints nullable="false"/>
            </column>
            <column name="SERIALIZED_CONTEXT" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint constraintName="STEP_EXEC_CTX_FK"
                                 baseTableName="PRG_BATCH_STEP_EXECUTION_CONTEXT" baseColumnNames="STEP_EXECUTION_ID"
                                 referencedTableName="PRG_BATCH_STEP_EXECUTION" referencedColumnNames="STEP_EXECUTION_ID"/>
        <rollback>
            <dropTable tableName="PRG_BATCH_STEP_EXECUTION_CONTEXT"/>
        </rollback>
    </changeSet>

    <changeSet id="prg-v1-batch-job-execution-context" author="dcre">
        <createTable tableName="PRG_BATCH_JOB_EXECUTION_CONTEXT">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SHORT_CONTEXT" type="VARCHAR(2500)">
                <constraints nullable="false"/>
            </column>
            <column name="SERIALIZED_CONTEXT" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_EXEC_CTX_FK"
                                 baseTableName="PRG_BATCH_JOB_EXECUTION_CONTEXT" baseColumnNames="JOB_EXECUTION_ID"
                                 referencedTableName="PRG_BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
        <rollback>
            <dropTable tableName="PRG_BATCH_JOB_EXECUTION_CONTEXT"/>
        </rollback>
    </changeSet>

    <changeSet id="prg-v1-batch-sequences" author="dcre">
        <createSequence sequenceName="PRG_BATCH_STEP_EXECUTION_SEQ" maxValue="9223372036854775807" cycle="false"/>
        <createSequence sequenceName="PRG_BATCH_JOB_EXECUTION_SEQ" maxValue="9223372036854775807" cycle="false"/>
        <createSequence sequenceName="PRG_BATCH_JOB_INSTANCE_SEQ" maxValue="9223372036854775807" cycle="false"/>
        <rollback>
            <dropSequence sequenceName="PRG_BATCH_STEP_EXECUTION_SEQ"/>
            <dropSequence sequenceName="PRG_BATCH_JOB_EXECUTION_SEQ"/>
            <dropSequence sequenceName="PRG_BATCH_JOB_INSTANCE_SEQ"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
